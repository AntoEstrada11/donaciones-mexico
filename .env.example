# Supabase — use ambos prefijos por compatibilidad con el módulo
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Solo servidor (nunca en el cliente)
SUPABASE_SERVICE_KEY=your-service-role-key

# URL pública del sitio (emails de confirmación / reset)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Docs OpenAPI/Scalar en /docs (true por defecto; false en prod si no quieres exponerlas)
NUXT_PUBLIC_API_DOCS=true

# Odoo — opcional; si vacío, partner_id se genera en mock
NUXT_ODOO_URL=
NUXT_ODOO_DB=
NUXT_ODOO_USERNAME=
NUXT_ODOO_PASSWORD=
