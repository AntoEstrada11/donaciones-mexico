# Copiar a .env. En Windows use 127.0.0.1 (no localhost) para Postgres y MinIO.
DATABASE_URL=postgresql://donaciones:donaciones@127.0.0.1:5432/donaciones
NUXT_AUTH_SECRET=cambia-este-secreto-largo

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_AUTH_HUB_URL=http://159.54.159.34:8000
NUXT_PUBLIC_APP_CODE=donaciones

# MinIO (npm run db:up). En Portainer el endpoint es http://minio:9000 y no se publica el puerto.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia-minio-en-local
NUXT_MINIO_ENDPOINT=http://127.0.0.1:9000
NUXT_MINIO_ACCESS_KEY=minioadmin
NUXT_MINIO_SECRET_KEY=cambia-minio-en-local
NUXT_MINIO_BUCKET_PRIVATE=donaciones-private
NUXT_MINIO_REGION=us-east-1
# Cifrado AES-256-GCM de objetos (recomendado distinto de AUTH_SECRET en producción)
NUXT_MINIO_OBJECT_SECRET=cambia-secreto-cifrado-objetos

# Correo transaccional (SMTP). Sin esto, en local se puede devolver el enlace en la respuesta.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM="Donaciones IURD <noreply@ejemplo.org>"
NUXT_SMTP_SECURE=false
NUXT_MAIL_DEV_RETURN_LINK=true

# CFDI / PAC (vacío = timbrado no disponible; solo constancia HTML)
NUXT_CFDI_PAC_API_URL=
NUXT_CFDI_PAC_API_KEY=

# Pasarelas (solo *_TEST en pruebas)
NUXT_MP_ACCESS_TOKEN_TEST=
NUXT_PAYPAL_CLIENT_ID_TEST=
NUXT_PAYPAL_CLIENT_SECRET_TEST=
