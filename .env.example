# Auth (cambia en producción)
NUXT_AUTH_SECRET=cambia-este-secreto-largo

# Base de datos PostgreSQL (Docker: npm run db:setup). En Windows usa 127.0.0.1, no localhost.
DATABASE_URL=postgresql://donaciones:donaciones@127.0.0.1:5432/donaciones

# Credenciales del contenedor de docker compose (deben coincidir con DATABASE_URL)
POSTGRES_USER=donaciones
POSTGRES_PASSWORD=donaciones
POSTGRES_DB=donaciones

# Opcional: correo a promover con npm run db:promote-admin (sin argumentos)
# ADMIN_EMAIL=

# Opcional: directorio de iglesias (Odoo vía Nitro). Si falla, se usa server/data/churches.json
# NUXT_CHURCHES_API_URL=https://miembros.iurdsys.net/api/churches
# NUXT_CHURCHES_API_KEY=
# Regenerar plan B: npm run db:sync-churches
# NUXT_CHURCHES_API_ALLOWED_HOST=miembros.iurdsys.net
# NUXT_CHURCHES_CACHE_TTL_MS=3600000

# URL a la que vuelve el navegador tras pagar (local: localhost)
# NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Base HTTPS pública solo para webhooks (ngrok). Si falta, se usa SITE_URL.
# NUXT_PAYMENT_WEBHOOK_BASE_URL=https://xxxx.ngrok-free.dev

# Auth Hub (identidad de operación). HTTP en Oracle Cloud (mx-queretaro-1). Sin slash final.
NUXT_PUBLIC_AUTH_HUB_URL=http://159.54.159.34:8000
NUXT_PUBLIC_APP_CODE=donaciones

# MercadoPago (solo servidor; nunca en runtimeConfig.public)
# NUXT_MP_ACCESS_TOKEN_TEST=
# NUXT_MP_ACCESS_TOKEN_LIVE=
# NUXT_MP_WEBHOOK_SECRET_TEST=
# NUXT_MP_WEBHOOK_SECRET_LIVE=

# PayPal (solo servidor)
# NUXT_PAYPAL_CLIENT_ID_TEST=
# NUXT_PAYPAL_CLIENT_ID_LIVE=
# NUXT_PAYPAL_CLIENT_SECRET_TEST=
# NUXT_PAYPAL_CLIENT_SECRET_LIVE=
# NUXT_PAYPAL_WEBHOOK_ID_TEST=
# NUXT_PAYPAL_WEBHOOK_ID_LIVE=
